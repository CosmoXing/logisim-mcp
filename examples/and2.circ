    <wire from="(120,280)" to="(290,280)"/>
    <wire from="(290,180)" to="(290,280)"/>
    <wire from="(340,160)" to="(340,200)"/>
    <wire from="(340,200)" to="(740,200)"/>
  </circuit>
</project>
