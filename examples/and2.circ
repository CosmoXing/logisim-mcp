  <circuit name="main">
    <a name="circuit" val="main"/>
    <comp lib="0" loc="(120,200)" name="Pin"><a name="type" val="input"/><a name="facing" val="east"/><a name="label" val="a"/></comp>
    <comp lib="0" loc="(120,280)" name="Pin"><a name="type" val="input"/><a name="facing" val="east"/><a name="label" val="b"/></comp>
    <comp lib="0" loc="(740,200)" name="Pin"><a name="type" val="output"/><a name="facing" val="west"/><a name="label" val="y"/></comp>
    <comp lib="1" loc="(340,160)" name="AND Gate"><a name="inputs" val="2"/></comp>
    <wire from="(120,140)" to="(120,200)"/>
